# OpenAI API Key (Optional for AI Advisory)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Copernicus Sentinel-2 Satellite Credentials (Optional for satellite NDVI)
SENTINEL_CLIENT_ID=your_sentinel_client_id_here
SENTINEL_CLIENT_SECRET=your_sentinel_client_secret_here
SENTINEL_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
SENTINEL_STATS_URL=https://sh.dataspace.copernicus.eu/statistics/v1
SATELLITE_MAX_CLOUD=35

# Google OAuth Client ID (Optional for Sign in with Google)
GOOGLE_CLIENT_ID=your_google_client_id_here
